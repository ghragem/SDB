# Públicas (seguras no navegador; protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side apenas. Nunca prefixar com NEXT_PUBLIC_. Nunca commitar.
# Sem nenhuma das duas, o app funciona com leitura por regras e avisa que a IA não está configurada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transcrição server-side (opcional). Sem ela, usa o reconhecimento de voz do navegador.
OPENAI_TRANSCRIBE_MODEL=whisper-1
